# Public origin of this server. OAuth issuer and Stripe return URLs use it.
APP_BASE_URL=http://127.0.0.1:8787
PORT=8787

# Signs browser sessions and is required in production. Generate a long random string.
AUTH_SECRET=

# Account document. memory (default) | file | http | blob
# Do not point this at a new database. One JSON document only.
# On Vercel use blob. Vercel injects BLOB_READ_WRITE_TOKEN; do not commit it.
STORAGE_BACKEND=memory
STORAGE_PATH=./data/patent-store.json
STORAGE_URL=
STORAGE_TOKEN=
STORAGE_BLOB_PATH=patent/accounts.json
BLOB_READ_WRITE_TOKEN=

# Free USPTO Open Data Portal key: https://data.uspto.gov/apis/getting-started
# USPTO.gov account, ID.me verification, then Manage API Key. Sent as X-API-KEY.
USPTO_API_KEY=

# Free EPO Open Patent Services consumer key and secret: https://developers.epo.org/
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET=
EPO_OPS_BASE=https://ops.epo.org/3.2

# Existing Stripe prices. Do not create products here. No amounts belong in this file.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_WEBHOOK_SECRET=
